# Host folder that contains your Calibre library (the folder with metadata.db). Mounted read-only.
CALIBRE_LIBRARY=/path/to/Calibre_Library
PORT=8080
DATABASE_PATH=/data/shelfsync.db
CALIBRE_DB_PATH=/calibre/metadata.db
HARDCOVER_TOKEN=
ABS_URL=https://audiobooks.example.com
ABS_TOKEN=
ABS_POLL_MINUTES=5
# Minimum minutes between progress updates sent to Hardcover for one book (finishing is immediate)
PUSH_INTERVAL_MINUTES=10
# Only items updated in ABS within this many days are synced (keeps your old backlog out)
ABS_MAX_AGE_DAYS=3
ADMIN_PASSWORD=
REGISTRATION_DISABLED=false
DRY_RUN=true
TZ=America/Chicago
